# Disvent Secrets & Config
# Copy this file to .env and modify as needed

# Authentication
DISVENT_AUTH_ENABLED=true
DISVENT_API_KEY=dev-secret-key-change-me

# ClickHouse Credentials
CLICKHOUSE_USER=disvent_user
CLICKHOUSE_PASSWORD=dev_clickhouse_password

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_password

# Generator Defaults
TARGET_RATE_PER_SEC=2500
ANOMALY_PROBABILITY=0.035
MAX_MESSAGES=0

# Streaming Engine Thresholds
RISK_AMOUNT_THRESHOLD=8000
RISK_COUNT_THRESHOLD=5
